{
  "name": "hc-professional-app",
  "version": "0.1.0",
  "description": "Abofonsa BridgeCare Professional — clinician mobile app (Ionic + Capacitor client of professional.abofonsa.com)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4300",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test --coverage --log-heap-usage -w=2",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:format": "prettier --write \"{,src/**/}*.{md,json,yml,html,js,mjs,cjs,ts,css,scss}\"",
    "prettier:check": "prettier --check \"{,src/**/}*.{md,json,yml,html,js,mjs,cjs,ts,css,scss}\"",
    "sync": "ng build --configuration production && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@angular/router": "19.2.25",
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.2",
    "@capacitor/core": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/angular": "8.8.16",
    "@ngx-translate/core": "15.0.0",
    "@stomp/stompjs": "7.3.0",
    "dayjs": "1.11.10",
    "idb-keyval": "6.3.0",
    "ionicons": "8.1.0",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "19.0.1",
    "@angular-devkit/build-angular": "19.2.27",
    "@angular/cli": "19.2.27",
    "@angular/compiler-cli": "19.2.25",
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jest": "29.5.11",
    "angular-eslint": "19.8.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "16.0.0",
    "jest-preset-angular": "14.6.2",
    "jest-sonar": "0.2.16",
    "prettier": "3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.5.4",
    "typescript-eslint": "8.66.0"
  }
}
